<?xml version="1.0" encoding="utf-8"?>
<!--
   Bis Android 11 (API 30). Siehe data_extraction_rules.xml: Nichts sichern, weil die
   verschlüsselte Datenbank ohne den gerätegebundenen Keystore-Schlüssel unlesbar wäre.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
